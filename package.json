{
  "name": "mood-classifier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Random Forest that names a song's mood from nine Spotify audio features, running in the browser.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
